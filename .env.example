# ============================================================
#  Copy this file to ".env" and fill in your real values.
#  NEVER commit the real .env file (it's in .gitignore).
# ============================================================

# --- HuggingFace ---
# Get a free token at: https://huggingface.co/settings/tokens  (type: Read)
HUGGINGFACEHUB_API_TOKEN=hf_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# LLM model served via HuggingFace Inference API (runs on HF servers, not your PC).
HF_LLM_REPO_ID=Qwen/Qwen2.5-7B-Instruct

# Embedding model (runs locally on your machine, downloaded once).
HF_EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2

# --- Twilio (used by main.py) ---
# From https://console.twilio.com  (Account Info panel)
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=your_twilio_auth_token
# Twilio WhatsApp sandbox sender (default sandbox number shown below)
TWILIO_WHATSAPP_FROM=whatsapp:+14155238886

# --- Meta WhatsApp Cloud API (used by main_meta.py) ---
# Any secret string you choose; enter the SAME value in the Meta webhook setup.
META_VERIFY_TOKEN=my_secret_verify_123
# From your Meta app > WhatsApp > API Setup page:
META_ACCESS_TOKEN=EAAxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
META_PHONE_NUMBER_ID=123456789012345
META_GRAPH_API_VERSION=v21.0

# --- Multi-user version: Postgres + pgvector (used by *_multi.py) ---
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/whatsapp_bot
